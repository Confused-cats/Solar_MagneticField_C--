{
    "tasks": [
        {
            "type": "cppbuild",
            "label" : "Build Magnetic Field Simulation",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++26",
                "-fopenmp",
                "${workspaceFolder}/MagneticFields_C++.cpp",
                "${workspaceFolder}/glad.c",
                "${workspaceFolder}/Camera.cpp",
                "${workspaceFolder}/Physics.cpp",
                "${workspaceFolder}/Graphics.cpp",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}",      
                "-L${workspaceFolder}/lib",   
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}\\MagneticFields_C++.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
